
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Audit {
  id String @id @default(cuid())
  slug String @unique

  // user input (fully structured, no JSON)
  toolId String
  plan String
  teamSize Int
  seats Int
  monthlySpend Float
  useCase String


  currentSpend Float
  optimizedSpend Float
  monthlySavings Float
  annualSavings Float

  
  recommendations Recommendation[]

  summary String?

  createdAt DateTime @default(now())
}

model Recommendation {
  id String @id @default(cuid())

  auditId String
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  title String
  description String
  monthlySavings Float

  createdAt DateTime @default(now())
}